{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aladdin-techec.local/sap-cfg/customer-vars.schema.json",
  "title": "SAP Configuration Template - Customer Variables",
  "description": "Customer variable file (design doc §4.1). Credentials and secrets are forbidden.",
  "type": "object",
  "required": ["template_id", "template_version", "customer", "target", "variables"],
  "additionalProperties": false,
  "properties": {
    "template_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
    "template_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "customer": { "type": "string", "minLength": 1, "maxLength": 80 },
    "target": { "$ref": "#/definitions/target" },
    "variables": { "$ref": "#/definitions/variables" }
  },
  "definitions": {
    "target": {
      "type": "object",
      "required": ["environment", "sap_system", "client"],
      "additionalProperties": false,
      "properties": {
        "environment": { "enum": ["DEV", "QA", "PRD"] },
        "sap_system": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,16}$" },
        "client": { "type": "string", "pattern": "^\\d{3}$" },
        "language": { "type": "string", "minLength": 2, "maxLength": 2 }
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "maxLength": 200 },
          { "type": "number" },
          { "type": "boolean" }
        ]
      },
      "propertyNames": {
        "not": { "pattern": "(?i)pass(word|wd)?|secret|token|pwd|sso|api[_-]?key|credential" }
      }
    }
  }
}
